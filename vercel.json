{
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/listing/:slug/",
      "destination": "/listing/"
    },
    {
      "source": "/business/:slug/",
      "destination": "/business/"
    },
    {
      "source": "/submit-event/",
      "destination": "/events/submit/"
    },
    {
      "source": "/submit-event",
      "destination": "/events/submit/"
    },
    {
      "source": "/events/submit/",
      "destination": "/events/submit/"
    },
    {
      "source": "/events/submit",
      "destination": "/events/submit/"
    },
    {
      "source": "/events/:slug/",
      "destination": "/events/detail/"
    },
    {
      "source": "/events/:slug",
      "destination": "/events/detail/"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/((?!assets/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/auto-mithram/(.*)",
      "destination": "https://www.automithram.com/$1",
      "permanent": true
    },
    {
      "source": "/auto-mithram/",
      "destination": "https://www.automithram.com/",
      "permanent": true
    },
    {
      "source": "/join-auto-mithram/(.*)",
      "destination": "https://www.automithram.com/join/$1",
      "permanent": true
    },
    {
      "source": "/join-auto-mithram/",
      "destination": "https://www.automithram.com/join/",
      "permanent": true
    },
    {
      "source": "/auto/(.*)",
      "destination": "https://www.automithram.com/auto/$1",
      "permanent": true
    }
  ]
}