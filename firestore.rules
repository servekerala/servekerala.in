rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'servekerala.in@gmail.com';
    }

    function isVerifiedOwner(email) {
      return request.auth != null
        && request.auth.token.email_verified == true
        && email is string
        && email == request.auth.token.email;
    }

    function isVerifiedProfileOwner(profile) {
      return request.auth != null
        && request.auth.token.email_verified == true
        && ((profile.get('email', '') is string && profile.get('email', '') == request.auth.token.email)
          || (profile.get('ownerEmail', '') is string && profile.get('ownerEmail', '') == request.auth.token.email));
    }

    function ownsBusiness(id, collection) {
      return request.auth != null
        && request.auth.token.email_verified == true
        && ((collection == 'listings'
             && exists(/databases/$(database)/documents/listings/$(id))
             && isVerifiedProfileOwner(get(/databases/$(database)/documents/listings/$(id)).data))
          || (collection == 'business_pages'
             && exists(/databases/$(database)/documents/business_pages/$(id))
             && isVerifiedProfileOwner(get(/databases/$(database)/documents/business_pages/$(id)).data))
          || (collection == ''
             && ((exists(/databases/$(database)/documents/listings/$(id))
                  && isVerifiedProfileOwner(get(/databases/$(database)/documents/listings/$(id)).data))
               || (exists(/databases/$(database)/documents/business_pages/$(id))
                  && isVerifiedProfileOwner(get(/databases/$(database)/documents/business_pages/$(id)).data)))));
    }

    function ownerProfileFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'name', 'shortDescription', 'description', 'servicesOffered', 'serviceIds', 'towns',
        'phone', 'whatsapp', 'website', 'address', 'whyChooseUs',
        'seoTitle', 'seoDescription', 'logo', 'coverImage', 'updatedAt'
      ])
      && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['serviceIds'])
        || (request.resource.data.serviceIds is list
          && request.resource.data.serviceIds.size() <= (resource.data.get('listingTier', 'regular') == 'premium' ? 100 : 10)));
    }

    // 1. Directory Listings
    match /listings/{document} {
      allow read: if true;
      allow create: if true;
      allow update: if isAdmin() || (isVerifiedProfileOwner(resource.data) && ownerProfileFieldsOnly());
      allow delete: if isAdmin();
    }

    // 2. Customer Leads / Quote Requests
    match /leads/{document} {
      // Public visitors can submit quotes
      allow create: if true;
      // Admins and the verified owner of the targeted profile can read inquiries
      allow read: if isAdmin() || ownsBusiness(resource.data.businessId, resource.data.get('businessCollection', ''));
      allow update, delete: if isAdmin();
    }

    // 3. Events Publishing Engine
    match /events/{document} {
      // Anyone can browse approved events
      allow read: if true;
      // Public can submit an event only in 'pending' status
      allow create: if request.resource.data.status == 'pending' || request.auth != null;
      // Only authenticated admin can approve, feature, edit, or delete events
      allow update, delete: if request.auth != null;
    }

    // 4. Business Pages & Landing Pages
    match /business_pages/{document} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() || (isVerifiedProfileOwner(resource.data) && ownerProfileFieldsOnly());
      allow delete: if isAdmin();
    }

    // 5. CMS & Platform Configuration
    match /cms_settings/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /site_seo/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /page_generator_config/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 6. Interaction / Analytics Logs
    match /analytics_events/{document} {
      allow create: if true;
      allow read: if isAdmin() || ownsBusiness(resource.data.business_id, resource.data.get('business_collection', ''));
      allow update, delete: if isAdmin();
    }

    // 7. Private rank-tracking campaigns and SERP snapshots
    match /seo_tracker_settings/{document} {
      allow read, write: if isAdmin();
    }

    match /seo_tracker_runs/{document} {
      allow read, write: if isAdmin();
    }
  }
}
