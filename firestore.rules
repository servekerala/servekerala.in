rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /listings/{document} {
      allow read, create: if true;
      allow update: if true;
      allow delete: if request.auth != null;
    }

    match /auto_mithram/{document} {
      allow read, create: if true;
      allow update: if true;
      allow delete: if request.auth != null;
    }

    match /business_pages/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /cms_settings/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /site_seo/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /page_generator_config/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
